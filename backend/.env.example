# Copy to backend/.env (or repo-root .env) and fill in. Never commit the real file.

# --- Claims data: Azure Cosmos DB (source of truth) ---
# The hot-spot map reads from here, so claims added/approved through the app
# appear on the map without a redeploy.
COSMOS_URI=https://<account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=guardian-db
COSMOS_CONTAINER=insurance-data
# User directory (members, employees, Crime Prevention Units), partitioned by
# /role. Created automatically; seed it with scripts/seed_users.py.
COSMOS_USERS_CONTAINER=users
USERS_CACHE_TTL_SECONDS=30

# "cosmos" (fail loudly if unreachable) | "csv" (offline) | "auto" (default:
# prefer Cosmos, fall back to the CSV so a dead network doesn't kill the demo)
CLAIMS_SOURCE=auto

# Seconds an in-memory claims snapshot is reused before re-querying Cosmos.
# Lower = new claims appear sooner; higher = fewer RUs and a snappier filter UI.
CLAIMS_CACHE_TTL_SECONDS=60

# Fallback CSV. Defaults to Gradhack_Insure_Data_CLEANED.csv in the repo root.
# CLAIMS_CSV_PATH=

# --- Database (Phase 2+, face recognition) ---
DATABASE_URL=postgresql://user:password@localhost:5432/guardian_db

# --- Azure Blob Storage (face images + claim media) ---
# Quote the value: connection strings contain semicolons, which dotenv would
# otherwise read as the start of a comment.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
# Private container for claim photos/video. Read access is granted per request
# via short-lived SAS URLs — never make this container public.
CLAIM_MEDIA_CONTAINER=claim-media
CLAIM_MEDIA_SAS_MINUTES=30
MAX_UPLOAD_MB=64

# --- Geocoding (OpenStreetMap / Nominatim) ---
# Defaults to backend/data/suburb_geocache.json, which is committed — you only
# need to run scripts/geocode_suburbs.py if you're rebuilding or extending it.
# GEOCACHE_PATH=
#
# Nominatim requires a descriptive User-Agent with real contact details and
# allows at most 1 request/second. Put your own contact here before running
# the geocoder, and don't lower the delay.
NOMINATIM_USER_AGENT=GuardianCollective-GradHack2026/1.0 (+https://github.com/ctrl-alt-elite)
NOMINATIM_DELAY_SECONDS=1.1

# --- Routing (Valhalla / OpenStreetMap) ---
# The public FOSSGIS instance needs no key. For demo-day reliability, self-host
# via Docker with a Geofabrik south-africa-latest.osm.pbf extract and point here.
VALHALLA_URL=https://valhalla1.openstreetmap.de/route
VALHALLA_TIMEOUT_SECONDS=30

# --- Travel-risk surface ---
# Res 7 is ~5 km across. Claims are located to suburb centroids, so finer
# resolutions would invent precision the data doesn't have.
RISK_H3_RESOLUTION=7
RISK_SMOOTHING_RINGS=2

# A cell must score this high to be worth routing around.
ROUTE_AVOID_THRESHOLD=0.55
# Cap on excluded areas — too many and the router either detours absurdly or
# finds no route at all.
ROUTE_MAX_AVOID_POLYGONS=12
# Past this much extra travel time, the safer route is shown but not advised.
ROUTE_MAX_DETOUR_RATIO=1.35
# And below this relative risk improvement it isn't suggested at all. Don't
# lower this to make a demo look better — see PROJECT_CONTEXT §9.
ROUTE_MIN_RISK_REDUCTION=0.20
ROUTE_HIGH_RISK_THRESHOLD=0.55
